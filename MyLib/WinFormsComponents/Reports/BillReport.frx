<Report ScriptLanguage="CSharp" ReportInfo.Created="06/15/2026 22:39:27" ReportInfo.Modified="06/19/2026 17:51:47" ReportInfo.CreatorVersion="2026.2.3.0">
  <ScriptText>using System;
using System.Collections;
using System.Collections.Generic;
using System.ComponentModel;
using System.Windows.Forms;
using System.Drawing;
using System.Data;
using FastReport;
using FastReport.Data;
using FastReport.Dialog;
using FastReport.Barcode;
using FastReport.Table;
using FastReport.Utils;                 

namespace FastReport
{
  public class ReportScript
  {   
    private static readonly TimeOnly Midnight = new TimeOnly(0, 0, 0);              
    
    public string FormatDays(int countDays)
    {
      if (countDays &lt;= 0) return &quot;0 дней&quot;;

      DateTime startDate = DateTime.Today;
      DateTime endDate = startDate.AddDays(countDays);

      int years = endDate.Year - startDate.Year;
      int months = endDate.Month - startDate.Month;
      int days = endDate.Day - startDate.Day;

      if (days &lt; 0)
      {
        months--;
        days += DateTime.DaysInMonth(startDate.Year, startDate.Month);
      }

      if (months &lt; 0)
      {
        years--;
        months += 12;
      }

      string builder = string.Empty;
      string format = &quot;\n{0}{1}&quot;;

      if (years &gt; 0)
      {
        string yearWord = GetDeclension(years, &quot;-го года&quot;, &quot;-х лет&quot;, &quot;-и лет&quot;);
        builder += string.Format(format, years, yearWord);
      }

      if (months &gt; 0)
      {
        string monthWord = GetDeclension(months, &quot;-го месяца&quot;, &quot;-х месяцов&quot;, &quot;-и месяцев&quot;);
        builder += string.Format(format, months, monthWord);
      }

      if (days &gt; 0 || builder.Length == 0)
      {
        string dayWord = GetDeclension(days, &quot;-го дня&quot;, &quot;-х дней&quot;, &quot;-и дней&quot;);
        builder += string.Format(format.TrimEnd(), days, dayWord);
      }

      return builder;
    }
    
    private string GetPayInfo(decimal sum, decimal sumInventory, DateTime date, DateTime returnDate, bool is_returned)
    {
      string status = &quot;Не оплачено&quot;;  

        if (sum &lt; sumInventory)
        {
          if (is_returned &amp;&amp; DateTime.Now.Date &gt; returnDate.Date)
          {
            status = &quot;Частичная оплата | Долг&quot;;      
          }
          else
          {
            status = &quot;Частичная оплата&quot;; ;
          }
  
          return String.Format(
            &quot;{0}\nОплачено: {1:N2} ₽\nОстаток: {2:N2} ₽\nДата платежа: {3:dd MMMM yyyy}&quot;, 
            status, sum, sumInventory-sum, date);
          }
        else
        {
          status = &quot;Оплачено&quot;; 
        
          if(sum &gt; sumInventory)
          {
            return String.Format(
              &quot;{0}\nОплачено: {1:N2} ₽\nИзлишек: {2:N2} ₽\nДата платежа: {3:dd MMMM yyyy}&quot;, 
              status, sum, sum-sumInventory, date);
          }
        }
  
        return String.Format(&quot;{0}\n{1:N2} ₽\nДата платежа: {2:dd MMMM yyyy}&quot;, status, sum, date);                                                                                  
     }
    
    public string GetPayInfo()
    {  
      bool isReturn = (Boolean)Report.GetColumnValue(&quot;RentalBaseInfo.is_returned&quot;);
      
      if((Boolean)Report.GetColumnValue(&quot;RentalBaseInfo.is_oplat&quot;))
      {
        decimal oplatSum = (Decimal)Report.GetColumnValue(&quot;RentalBaseInfo.oplat_sum&quot;);
        int rentalDays = (Int32)Report.GetColumnValue(&quot;RentalBaseInfo.rental_days&quot;);
        decimal sumInventory = Report.GetTotalValue(&quot;SumInventory&quot;);
        DateTime oplatDate = ConvertToDateTime(Report.GetColumnValue(&quot;RentalBaseInfo.oplat_date&quot;)); 
        
        if(isReturn)
        {
          DateTime returnDate = ConvertToDateTime(Report.GetColumnValue(&quot;RentalBaseInfo.return_date&quot;));
          
          return GetPayInfo(oplatSum, sumInventory*rentalDays, oplatDate, returnDate, isReturn);
        }
        else
        {
          return GetPayInfo(oplatSum, sumInventory*rentalDays, oplatDate, DateTime.MinValue, isReturn);
        }
      }
      else
      {
        return isReturn ? &quot;Не оплачено | Долг&quot; : &quot;Не оплачено&quot;;
      }        
    }
    
    public string GetReturnDate()
    {                                                                                                                                             
      bool isReturn = (Boolean)Report.GetColumnValue(&quot;RentalBaseInfo.is_returned&quot;);
      
      if(isReturn)
      {
        DateTime returnDate = ConvertToDateTime(Report.GetColumnValue(&quot;RentalBaseInfo.return_date&quot;));
        
        return String.Format(&quot;По {0:dd MMMM yyyy}&quot;, returnDate);
      }
      else
      {
	      return &quot;На текущий момент продолжается.&quot;;   
      }
    }
    
    public string GetDeclension(int number, string formFirst, string formSecond, string formThird)
    {
      number = Math.Abs(number) % 100;
      if (number &gt;= 11 &amp;&amp; number &lt;= 19) return formThird;
  
      number %= 10;
      if (number == 1) return formFirst;
      if (number &gt;= 2 &amp;&amp; number &lt;= 4) return formSecond;
      return formThird;
    }
                                                     
    private DateTime ConvertToDateTime(object value)
    { 
      if (value is DateTime) return (DateTime)value;
        
      return ((DateOnly)value).ToDateTime(Midnight);
    }
  }
}
</ScriptText>
