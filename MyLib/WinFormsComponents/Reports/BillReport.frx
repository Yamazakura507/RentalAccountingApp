    <PostgresDataConnection Name="Connection" ConnectionString="rijcmlqi9AW9QKfpRqZHmajH+zxgZktPtik/SHpHSaEQX1JjIEyfdP/j46x6o8tFqR16hoIo3ixdDY2RxB8h5w2HwmGTEsAQc+LzvkwiISbRBygJEr88dv+9XRwGwTgAiNJZKmB">
      <TableDataSource Name="Table" Alias="RentalBaseInfo" DataType="System.Int32" Enabled="true" SelectCommand="select r.&quot;Id&quot; id_bill,&#13;&#10;	c.&quot;OwnerName&quot; client, &#13;&#10;	c.&quot;Phone&quot; client_phone, &#13;&#10;	p.&quot;Sum&quot; oplat_sum, &#13;&#10;	p.&quot;Date&quot; oplat_date,&#13;&#10;	r.&quot;IssueDate&quot; issue_date,&#13;&#10;	r.&quot;ReturnDate&quot; return_date,&#13;&#10;	r.&quot;ReturnDate&quot; is not null is_returned, &#13;&#10;	p.&quot;Sum&quot; is not null is_oplat, &#13;&#10;	extract(day from (coalesce(r.&quot;ReturnDate&quot;, now()) - r.&quot;IssueDate&quot;))::int+1 rental_days&#13;&#10;from &quot;Rental&quot; r &#13;&#10;	inner join &quot;Clients&quot; c on c.&quot;Id&quot; = r.&quot;IdClient&quot;&#13;&#10;	left join &quot;Payments&quot; p on p.&quot;Id&quot; = r.&quot;IdPayment&quot;&#13;&#10;where r.&quot;Id&quot; = @id">
        <Column Name="client" DataType="System.String"/>
        <Column Name="client_phone" DataType="System.String"/>
        <Column Name="oplat_sum" DataType="System.Decimal"/>
        <Column Name="oplat_date" DataType="System.DateTime"/>
        <Column Name="issue_date" DataType="System.DateTime"/>
        <Column Name="return_date" DataType="System.DateTime"/>
        <Column Name="rental_days" DataType="System.Int32"/>
        <Column Name="id_bill" DataType="System.Int32"/>
        <Column Name="is_returned" DataType="System.Boolean" BindableControl="CheckBox"/>
        <Column Name="is_oplat" DataType="System.Boolean" BindableControl="CheckBox"/>
        <CommandParameter Name="id" DataType="9" Expression="[idRental]"/>
      </TableDataSource>
      <TableDataSource Name="Table1" Alias="RentalInventory" DataType="System.Int32" Enabled="true" SelectCommand="select i.&quot;Name&quot;, i.&quot;Price&quot;&#13;&#10;from &quot;Rental&quot; r &#13;&#10;	inner join &quot;InventoryRental&quot; ir on ir.&quot;IdRental&quot; = r.&quot;Id&quot; &#13;&#10;	inner join &quot;Inventory&quot; i on i.&quot;Id&quot; = ir.&quot;IdInventory&quot;  &#13;&#10;where r.&quot;Id&quot; = @id">
        <Column Name="name" DataType="System.String"/>
        <Column Name="price" DataType="System.Decimal"/>
        <CommandParameter Name="id" DataType="9" Expression="[idRental]"/>
      </TableDataSource>
    </PostgresDataConnection>
    <Parameter Name="idRental" DataType="System.Int32" Expression="14"/>
    <Total Name="SumInventory" Expression="[RentalInventory.price]" Evaluator="Data2"/>
    <Total Name="CountInventory" TotalType="Count" Evaluator="Data2"/>
  </Dictionary>
